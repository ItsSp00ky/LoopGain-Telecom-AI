# Copy this file to `.env` in the same folder and fill it in. `.env` is git-ignored.
# A variable already set in the terminal wins over the file.

# Your key from console.groq.com.
GROQ_API_KEY=

# The prepaid service, and the keys it was started with (24 or more characters, different).
PREPAID_CHURN_URL=http://127.0.0.1:8000
PREPAID_CHURN_CHATBOT_KEY=
PREPAID_CHURN_COPILOT_KEY=
