# Raw data in data/raw/ is committed on purpose (docs/decisions.md, decision 9).
# Processed data is rebuilt from it by the pipeline.
data/processed/*
!data/processed/.gitkeep

# Trained model bundles
artifacts/

# T17 downloads the Orange Belgium and Criteo uplift datasets here.
# They are other people's data under non-commercial licences (decision 30), so they are
# fetched on demand and never committed.
data/external/
