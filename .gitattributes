# Normalise line endings so the Windows and Linux halves of the team stop
# fighting over whitespace-only diffs.
* text=auto eol=lf

*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.sh    text eol=lf

*.py    text diff=python
*.md    text
*.yml   text
*.yaml  text
*.json  text
*.toml  text
*.csv   text
*.sql   text

# Binary — never try to merge or diff these
*.png       binary
*.jpg       binary
*.pdf       binary
*.xlsx      binary
*.parquet   binary
*.npz       binary
*.duckdb    binary
*.h5        binary
*.keras     binary
*.joblib    binary
*.safetensors binary

# Notebooks: keep diffs readable, and mark them so GitHub language stats
# report this as a Python project rather than a Jupyter one.
*.ipynb text
*.ipynb linguist-documentation
docs/**  linguist-documentation
