<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" android:background="@color/brand_navy" android:theme="@style/ThemeOverlay.KpiMonitor.Toolbar" app:title="@string/app_name" app:titleTextColor="@color/on_brand" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="24dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="28dp" android:paddingBottom="18dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/dashboardHeading" android:text="@string/dashboard_heading" android:textSize="28sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/dashboard_intro" android:textSize="15sp" android:lineSpacingExtra="3dp" android:textColor="@color/text_secondary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="8dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <TextView android:id="@+id/summaryHeading" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/summary_heading" android:textSize="20sp" android:textColor="@color/text_primary" android:fontFamily="sans-serif-medium" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/refreshSummary" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/refresh_summary" android:textAllCaps="false" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <ProgressBar android:id="@+id/summaryProgress" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="8dp" android:indeterminateTint="@color/brand_blue" android:importantForAccessibility="no" />
                    <TextView android:id="@+id/summaryStatus" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/summary_loading" android:textSize="12sp" android:textColor="@color/text_secondary" android:accessibilityLiveRegion="polite" />
                </LinearLayout>
            </LinearLayout>
            <GridLayout android:id="@+id/summaryGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:paddingStart="12dp" android:paddingEnd="12dp" android:alignmentMode="alignMargins">
                <include layout="@layout/item_summary_card" android:id="@+id/summaryKpi" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:layout_gravity="fill_horizontal" />
                <include layout="@layout/item_summary_card" android:id="@+id/summarySteering" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:layout_gravity="fill_horizontal" />
                <include layout="@layout/item_summary_card" android:id="@+id/summaryTraffic" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:layout_gravity="fill_horizontal" />
                <include layout="@layout/item_summary_card" android:id="@+id/summaryGis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:layout_gravity="fill_horizontal" />
                <include layout="@layout/item_summary_card" android:id="@+id/summaryChurn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="6dp" android:layout_gravity="fill_horizontal" />
            </GridLayout>
            <TextView android:id="@+id/modulesHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="16dp" android:paddingBottom="12dp" android:text="@string/dashboard_modules" android:textSize="12sp" android:letterSpacing="0.1" android:fontFamily="sans-serif-medium" android:textColor="@color/text_secondary" />
            <GridLayout android:id="@+id/moduleGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:paddingStart="12dp" android:paddingEnd="12dp" android:alignmentMode="alignMargins">
                <include layout="@layout/item_dashboard_card" android:id="@+id/cardOverview" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="6dp" />
                <include layout="@layout/item_dashboard_card" android:id="@+id/cardNetwork" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="6dp" />
                <include layout="@layout/item_dashboard_card" android:id="@+id/cardSteering" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="6dp" />
                <include layout="@layout/item_dashboard_card" android:id="@+id/cardGis" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="6dp" />
                <include layout="@layout/item_dashboard_card" android:id="@+id/cardChurn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="6dp" />
                <include layout="@layout/item_dashboard_card" android:id="@+id/cardAssistants" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill_horizontal" android:layout_margin="6dp" />
            </GridLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="20dp" android:paddingBottom="12dp">
                <TextView android:id="@+id/attentionHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/attention_heading" android:textSize="20sp" android:fontFamily="sans-serif-medium" android:textColor="@color/text_primary" />
                <LinearLayout android:id="@+id/attentionList" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/summary_evidence_note" android:textSize="12sp" android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <include layout="@layout/view_ai_assistant_bar" />
</LinearLayout>
