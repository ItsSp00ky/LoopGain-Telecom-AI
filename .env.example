# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#   PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
CVM_ENV=dev                     # dev | ci | demo
CVM_LOG_LEVEL=INFO
CVM_RANDOM_SEED=606             # MCC 606. Every stochastic step reads this.

# --- Paths (inside containers these are remapped by docker-compose) --------
CVM_DATA_DIR=./data
CVM_ARTIFACT_DIR=./artifacts
CVM_FEATURE_STORE=./data/processed/features_online.duckdb

# --- Privacy ---------------------------------------------------------------
# Salt for SHA-256 subscriber hashing. Generate your own; never reuse across
# environments. No raw MSISDN may exist anywhere in this repository.
#   python -c "import secrets; print(secrets.token_hex(32))"
CVM_HASH_SALT=CHANGE_ME_generate_a_64_char_hex_string

# --- MLflow ----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=ai-cvm-suite

# --- API -------------------------------------------------------------------
CVM_API_HOST=0.0.0.0
CVM_API_PORT=8000
CVM_API_URL=http://localhost:8000     # what the Streamlit apps call

# --- Dataset sources -------------------------------------------------------
# Dataset A (UCI 563) needs no key — fetched via `ucimlrepo`.
# Dataset B (Cell2Cell) is on Kaggle; put kaggle.json in ~/.kaggle/ or set:
KAGGLE_USERNAME=
KAGGLE_KEY=
# Dataset D — free key from https://opencellid.org/register.php
OPENCELLID_API_KEY=

# --- LLM inference -- OPTIONAL in this branch ------------------------------
# Only used to write Arabic offer copy in the channel simulator. The LLM
# writes wording from reason codes the decision engine already produced; it
# never invents a price, a bonus or a limit.
# Leave blank and the simulator falls back to templated copy.
# The Employee Copilot and Customer Chatbot are other components -- they carry
# their own keys.
LLM_PROVIDER=groq                # groq | openrouter | huggingface
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.0
